# .env.example — copy to .env (which is gitignored) and adjust if needed:
#   cp .env.example .env
#
# The defaults below are SAFE LOCAL-DEV values that match appsettings.json, so the very same
# JWT you mint at jwt.io works for BOTH `dotnet run` and Docker, and `docker compose up`
# works out of the box. These are development-only; production uses a real secret manager.

# PostgreSQL password, used by the db container AND the API's connection string.
# NOTE: Postgres only applies this on the FIRST init of the data volume. If you change it
# after the volume already exists, recreate it:  docker compose down -v
DB_PASSWORD=MYPASSWORD1234!

# JWT signing key. MUST match the secret you paste into jwt.io (see README -> "Getting a token").
# Keep this at least 32 characters or the API refuses to start.
JWT_SIGNING_KEY=local-dev-jwt-signing-key-change-me-at-least-32chars

# Download-link signing key (server-side only; any value at least 32 characters).
DOWNLOAD_TOKEN_SIGNING_KEY=local-dev-download-token-signing-key-change-me-32chars


